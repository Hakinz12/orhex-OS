# ==============================================================================
# ORHREX OS — Environment Configuration Template
# Hackathon: Tatum x Walrus Total Recall 2026 (Track: Smart Agents for Real Life)
#
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Populate with your authentic credentials.
# 3. NEVER commit the resulting .env file to version control.
# ==============================================================================

# --- Application Core ---
APP_NAME="ORHREX OS"
APP_ENV="development"                  # development | production | test
API_HOST="127.0.0.1"
API_PORT=8000
SECRET_KEY="replace-with-a-secure-random-secret-key-min-32-chars"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
API_PUBLIC_URL=""                     # Required HTTPS origin in production
AUTH_TOKEN_TTL_HOURS=24               # New opaque access-token lifetime
AUTH_RATE_LIMIT_PER_MINUTE=60         # Per-process limit for /api/v1/memory/*

# --- Relational Database (SQLAlchemy Async) ---
# Default fallback uses SQLite async for zero-dependency local development.
# For production (Postgres/Supabase/Neon), provide: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL="sqlite+aiosqlite:///./orhrex.db"

# --- AI Provider: Google Gemini API ---
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
LLM_PROVIDER="gemini"

# --- Persistent Memory: Walrus Memory (Mainnet) ---
# Walrus Memory credentials for agent memory namespaces
# Refer to Walrus documentation: https://docs.wal.app/walrus-memory/
#
# MEMWAL_PRIVATE_KEY: 64-character hex string (32-byte Ed25519 signing key).
#   Obtain from the Walrus Memory dashboard under "Delegate Keys".
#   NEVER commit this value. Keep strictly on the backend.
#
# MEMWAL_ACCOUNT_ID: Sui object ID of your Walrus Memory account (0x + 64 hex chars).
#   Obtained from the Walrus Memory dashboard.
#
# MEMWAL_AGENT_ID: Your agent's registration identifier (separate from ACCOUNT_ID).
#   Captured from the Walrus Memory dashboard after creating an agent.
#
# MEMWAL_SERVER_URL: Official Mainnet relayer. Do NOT use https://memory.wal.app (404).
#   Use the SDK prod preset: https://relayer.memory.walrus.xyz
#
# MEMWAL_NAMESPACE: Your application's dedicated memory namespace.
#   Use a stable, unique name. Memories are scoped per namespace.
MEMWAL_AGENT_ID=""                     # Walrus Memory agent registration ID
MEMWAL_ACCOUNT_ID=""                   # Sui account object ID (0x + 64 hex)
MEMWAL_PRIVATE_KEY=""                  # Ed25519 delegate private key — 64 hex chars, backend-only
MEMWAL_SERVER_URL="https://relayer.memory.walrus.xyz"  # Official Mainnet relayer (SDK prod preset)
MEMWAL_NAMESPACE="orhrex-personal-memory"              # Dedicated ORHREX memory namespace
WALRUS_NETWORK="mainnet"

# --- Blockchain Intelligence: Tatum Sui RPC Gateway ---
# Obtain Tatum API key from https://dashboard.tatum.io/
TATUM_API_KEY=""
TATUM_SUI_RPC_URL="https://sui-mainnet.gateway.tatum.io"
SUI_NETWORK="mainnet"
# Optional default Sui address to demonstrate read-only wallet insights (e.g. hackathon demo address)
DEMO_SUI_ADDRESS=""

# --- Frontend Settings (Next.js) ---
# Note: In Next.js, only variables prefixed with NEXT_PUBLIC_ are bundled into the client browser.
# DO NOT place private keys, delegate keys, or Tatum secret keys in NEXT_PUBLIC_ variables!
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"
NEXT_PUBLIC_APP_TITLE="ORHREX OS — Intelligence That Anticipates"
