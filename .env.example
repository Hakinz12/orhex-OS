# ==============================================================================
# ORHREX OS — Environment Configuration Template
# Hackathon: Tatum x Walrus Total Recall 2026 (Track: Smart Agents for Real Life)
#
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Populate with your authentic credentials.
# 3. NEVER commit the resulting .env file to version control.
# ==============================================================================

# --- Application Core ---
APP_NAME="ORHREX OS"
APP_ENV="development"                  # development | production | test
API_HOST="127.0.0.1"
API_PORT=8000
SECRET_KEY="replace-with-a-secure-random-secret-key-min-32-chars"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- Relational Database (SQLAlchemy Async) ---
# Default fallback uses SQLite async for zero-dependency local development.
# For production (Postgres/Supabase/Neon), provide: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL="sqlite+aiosqlite:///./orhrex.db"

# --- AI Provider: Google Gemini API ---
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
LLM_PROVIDER="gemini"

# --- Persistent Memory: Walrus Memory (Mainnet) ---
# Walrus Memory credentials for agent memory namespaces
# Refer to Walrus documentation: https://docs.wal.app/walrus-memory/
MEMWAL_AGENT_ID=""                     # Registered agent ID in Walrus Memory
MEMWAL_ACCOUNT_ID=""                   # Sui Account ID associated with the agent
MEMWAL_PRIVATE_KEY=""                  # Ed25519 delegate private key for authenticated writes (kept strictly backend-side)
MEMWAL_SERVER_URL="https://memory.wal.app" # Walrus Memory Relayer / Endpoint
WALRUS_NETWORK="mainnet"

# --- Blockchain Intelligence: Tatum Sui RPC Gateway ---
# Obtain Tatum API key from https://dashboard.tatum.io/
TATUM_API_KEY=""
TATUM_SUI_RPC_URL="https://sui-mainnet.gateway.tatum.io"
SUI_NETWORK="mainnet"
# Optional default Sui address to demonstrate read-only wallet insights (e.g. hackathon demo address)
DEMO_SUI_ADDRESS=""

# --- Frontend Settings (Next.js) ---
# Note: In Next.js, only variables prefixed with NEXT_PUBLIC_ are bundled into the client browser.
# DO NOT place private keys, delegate keys, or Tatum secret keys in NEXT_PUBLIC_ variables!
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000"
NEXT_PUBLIC_APP_TITLE="ORHREX OS — Intelligence That Anticipates"

